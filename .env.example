# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard — credentials are hashed (scrypt) at seed time and never stored in source.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session + captcha signing secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
CAPTCHA_SECRET=

# Contact form email delivery (SMTP is used automatically when configured)
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Legacy Supabase (optional — app currently uses the local JSON store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant — the built-in smart assistant works without a key. Add a key for full LLM reasoning:
# - Option A (OpenAI or any OpenAI-compatible endpoint): set OPENAI_API_KEY + OPENAI_MODEL (+ OPENAI_BASE_URL if not OpenAI).
# - Option B (free tier via Google AI Studio): set GEMINI_API_KEY (+ GEMINI_MODEL, default gemini-2.5-flash).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email via Resend (optional alternative to SMTP)
RESEND_API_KEY=

# OTP + contact email via SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mobile (Expo)
EXPO_PUBLIC_API_BASE=http://localhost:3000
